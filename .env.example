# AsliVox Environment Configuration

# Application settings
APP_NAME=AsliVox
DEBUG=false

# Audio preprocessing parameters
SAMPLE_RATE=16000
N_MELS=64
N_FFT=1024
HOP_LENGTH=512
VAD_AGGRESSIVENESS=3
MIN_AUDIO_LEN_SEC=0.25

# Heavy feature extraction flag
# Set to false for demo mode (instant, low latency). Set to true only if transformers & GPU are configured.
USE_EMBEDDINGS=false

# Trained model path (leave default or point to trained LightGBM weights)
MODEL_PATH=src/asli_vox/models/lgb_spoof_model.joblib

# Server settings
HOST=0.0.0.0
PORT=8000
